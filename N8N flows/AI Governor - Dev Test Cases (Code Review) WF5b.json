      "id": "c036f005-2558-40c1-8e32-0a92d93ebc84",
      "name": "Jira Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -1136,
        432
      ],
      "webhookId": "jira-code-review"
    },
    {
      "parameters": {
        "jsCode": "// Extract Jira ticket fields from webhook payload.\n// Also flag whether this is a subtask transition vs a parent ticket update.\nconst body   = $input.first().json.body || $input.first().json;\nconst issue  = body.issue || {};\nconst fields = issue.fields || {};\nconst issueType = (fields.issuetype && fields.issuetype.name) || '';\nconst isSubtask = (fields.issuetype && fields.issuetype.subtask) === true;\nconst parentKey = (fields.parent && fields.parent.key) || '';\n\nreturn [{\n  json: {\n    issueKey:    issue.key || '',\n    summary:     fields.summary || '',\n    description: fields.description || '',\n    status:      (fields.status && fields.status.name) || '',\n    statusNormalized: ((fields.status && fields.status.name) || '').trim().toLowerCase(),\n    assignee:    (fields.assignee && fields.assignee.displayName) || '',\n    email:       (fields.assignee && fields.assignee.emailAddress) || '',\n    priority:    (fields.priority && fields.priority.name) || '',\n    issueType,\n    isSubtask,\n    parentKey,\n    reporter:    (fields.reporter && fields.reporter.displayName) || '',\n    projectKey:  (fields.project && fields.project.key) || '',\n    repoUrl:     (fields.customfield_repo_url) || ''\n  }\n}];"
      },
      "id": "09cfb127-0cec-44f4-8c5b-0bf316e08b63",
      "name": "Extract Jira Fields",
      "type": "n8n-nodes-base.code",
