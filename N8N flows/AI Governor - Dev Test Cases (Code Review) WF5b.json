    {
      "parameters": {
        "method": "POST",
        "url": "http://ai.{{YOUR_API_DOMAIN}}:8000/testcases/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"issueKey\": \"{{ $('Extract Jira Fields').item.json.issueKey }}\",\n  \"summary\": \"{{ $('Extract Jira Fields').item.json.summary }}\",\n  \"description\": {{ JSON.stringify($('Extract Jira Fields').item.json.description) }},\n  \"projectKey\": \"{{ $('Extract Jira Fields').item.json.projectKey }}\",\n  \"repoUrl\": \"{{ $('Extract Jira Fields').item.json.repoUrl }}\",\n  \"audience\": \"dev\",\n  \"pr_context\": {{ JSON.stringify($('Fetch PR Context').item.json.contextText) }},\n  \"repos\": [\"{{ $('PR Gate').item.json.repo }}\"]\n}",
        "options": {
          "timeout": 600000
        }
      },
      "id": "6d44249b-8380-406a-9685-6eec1c08003e",
      "name": "Build Test Cases (RepoTree)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -48,
        -16
      ]
    },
    {
      "parameters": {
        "jsCode": "// Normalize testcases array into a single comment body + DB rows.\nconst api = $input.first().json;\nconst jiraCtx = $('Extract Jira Fields').first().json;\n\nconst testcases = api.testcases || api.test_cases || [];\nconst total = testcases.length;\n\n// Build ONE comment containing all test cases, using Jira wiki markup.\nconst blocks = testcases.map((tc, i) => {\n  const title = tc.title || tc.name || `Test Case ${i + 1}`;\n  const steps = (tc.steps || []).map((s, j) => `  ${j + 1}. ${s}`).join('\\n');\n  const expected = tc.expected || tc.expected_result || '';\n  let b = `*[TC ${i + 1}] ${title}*`;\n  if (steps)    b += `\\n_Steps:_\\n${steps}`;\n  if (expected) b += `\\n_Expected:_ ${expected}`;\n  return b;\n}).join('\\n\\n----\\n\\n');\n\nconst commentBody =\n  `h3. 🧪 Auto-generated Developer Test Cases (${total})\\n` +\n  `_Generated by AI Governor RepoTree for ${jiraCtx.issueKey}._\\n` +\n  `{anchor:AI-GOVERNOR-TESTCASES-DEV-V1}\\n\\n` +\n  blocks;\n\nconst slackMessage = `🧪 *Developer test cases generated for ${jiraCtx.issueKey}*\\n` +\n  `Summary: ${jiraCtx.summary}\\n` +\n  `Total developer test cases: *${total}* (posted as a comment on the ticket)\\n` +\n  `<https://{{YOUR_JIRA_DOMAIN}}/browse/${jiraCtx.issueKey}|Open in Jira>`;\n\nreturn [{\n  json: {\n    ...jiraCtx,\n    totalTestcases: total,\n    testcases,\n    commentBody,\n    slackMessage\n  }\n}];"
      },
      "id": "811e2198-0a1a-4389-9254-68523c841756",
      "name": "Prepare TC Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        176,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// Flatten testcases into rows for Postgres bulk insert.\n// Test cases now live in a ticket comment (no subtasks), so no subtask_key.\nconst ctx = $input.first().json;\nconst tcs = ctx.testcases || [];\n\nconst rows = tcs.map((tc, i) => ({\n  jira_ticket_id: ctx.issueKey,\n  tc_index: i + 1,\n  subtask_key: null, // no longer creating subtasks; kept for schema compatibility\n  title: tc.title || tc.name || `Test Case ${i + 1}`,\n  steps: JSON.stringify(tc.steps || []),\n  expected: tc.expected || tc.expected_result || ''\n}));\n\nreturn [{\n  json: {\n    ...ctx,\n    rowsToInsert: rows,\n    commentPosted: ctx.commentPosted === true,\n    totalTestcases: tcs.length\n  }\n}];"
      },
      "id": "0bc87247-4060-4a70-8330-36901bf71477",
      "name": "Flatten TCs for DB",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        0
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH t AS (\n  SELECT id FROM tickets WHERE jira_ticket_id = '{{ $('Extract Jira Fields').item.json.issueKey }}' LIMIT 1\n)\nINSERT INTO test_cases (ticket_id, jira_ticket_id, phase, tc_index, subtask_key, title, steps, expected, status)\nSELECT\n  (SELECT id FROM t),\n  r.jira_ticket_id, 'dev', r.tc_index, r.subtask_key, r.title, r.steps::jsonb, r.expected, 'pending'\nFROM jsonb_to_recordset('{{ JSON.stringify($json.rowsToInsert).replace(/'/g, \"''\") }}'::jsonb)\n  AS r(jira_ticket_id text, tc_index int, subtask_key text, title text, steps text, expected text)\nON CONFLICT (jira_ticket_id, phase, tc_index)\nDO UPDATE SET\n  subtask_key = EXCLUDED.subtask_key,\n  title = EXCLUDED.title, steps = EXCLUDED.steps, expected = EXCLUDED.expected,\n  status = 'pending', updated_at = NOW()\nRETURNING id, tc_index, subtask_key;",
        "options": {}
      },
