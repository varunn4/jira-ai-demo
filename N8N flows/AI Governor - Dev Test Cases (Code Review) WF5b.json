    {
      "parameters": {
        "operation": "executeQuery",
        "query": "CREATE TABLE IF NOT EXISTS testcase_threads (\n  slack_channel_id TEXT NOT NULL,\n  slack_thread_ts  TEXT NOT NULL,\n  jira_ticket_id   TEXT NOT NULL,\n  phase            VARCHAR(8) NOT NULL DEFAULT 'qa',\n  created_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  updated_at       TIMESTAMPTZ NOT NULL DEFAULT NOW(),\n  PRIMARY KEY (slack_channel_id, slack_thread_ts)\n);\n\nINSERT INTO tickets (jira_ticket_id, slack_channel_id, slack_thread_ts, status)\nVALUES (\n  '{{ $('Extract Jira Fields').item.json.issueKey }}',\n  '{{ $json.channel || $json.message?.channel }}',\n  '{{ $json.message?.ts || $json.ts }}',\n  '{{ ($('Extract Jira Fields').item.json.status || 'open').replace(/'/g, \"''\") }}'\n)\nON CONFLICT (jira_ticket_id)\nDO UPDATE SET\n  slack_channel_id = EXCLUDED.slack_channel_id,\n  slack_thread_ts  = EXCLUDED.slack_thread_ts;\n\nINSERT INTO testcase_threads (slack_channel_id, slack_thread_ts, jira_ticket_id, phase)\nVALUES (\n  '{{ $json.channel || $json.message?.channel }}',\n  '{{ $json.message?.ts || $json.ts }}',\n  '{{ $('Extract Jira Fields').item.json.issueKey }}',\n  'dev'\n)\nON CONFLICT (slack_channel_id, slack_thread_ts)\nDO UPDATE SET\n  jira_ticket_id = EXCLUDED.jira_ticket_id,\n  phase = EXCLUDED.phase,\n  updated_at = NOW()\nRETURNING jira_ticket_id, phase;",
        "options": {}
