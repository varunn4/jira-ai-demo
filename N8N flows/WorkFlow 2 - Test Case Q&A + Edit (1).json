    {
      "parameters": {
        "jsCode": "const event = $('Slack_bot').item.json.body.event;\n// Strip Slack user/bot mentions like <@U123> and surrounding whitespace.\nconst raw = (event.text || '').replace(/<@[^>]+>/g, '').trim();\nreturn [{\n  json: {\n    user_id: event.user,\n    slack_channel_id: event.channel,\n    slack_thread_ts: event.thread_ts || event.ts,\n    user_message: raw\n  }\n}];"
      },
