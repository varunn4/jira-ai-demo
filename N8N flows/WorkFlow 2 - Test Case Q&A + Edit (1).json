    {
      "parameters": {
        "jsCode": "const api = $input.item.json || {};\nconst prepared = $('Prepare API Payload').item.json;\nconst reply = api.reply\n  || (api.error ? `\\u26a0\\ufe0f The assistant hit an error: ${api.error}` : null)\n  || 'Sorry, I could not generate a reply just now. Please try again.';\nreturn [{\n  json: {\n    slack_channel_id: api.slack_channel_id || prepared.slack_channel_id,\n    slack_thread_ts: api.slack_thread_ts || prepared.slack_thread_ts,\n    replyText: reply\n  }\n}];"
