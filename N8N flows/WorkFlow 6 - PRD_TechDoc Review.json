        "query": "SELECT t.slack_thread_ts, t.slack_channel_id\nFROM (SELECT '{{ $('Extract Jira Fields').item.json.issueKey }}'::text AS k) q\nLEFT JOIN tickets t ON t.jira_ticket_id = q.k\nLIMIT 1;",
        "options": {}
