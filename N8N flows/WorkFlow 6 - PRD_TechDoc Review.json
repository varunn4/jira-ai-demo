      "id": "8e7427c5-ae69-4a2d-90b0-41997ae58885",
      "name": "Fetch Jira Comments",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -928,
        144
      ],
      "credentials": {
        "jiraSoftwareCloudApi": {
          "id": "mKvgFGibDdGVCevK",
          "name": "Jira SW Cloud account"
        }
      },
      "notes": "Attach your Jira SW Cloud API credential (base URL + email + API token). No $env needed — this instance blocks env access inside Code nodes."
    },
    {
      "parameters": {
        "jsCode": "// Find the AI-Governor doc-review comment in the Jira comments response,\n// clean it lightly for Slack, and carry it forward. No $env access here.\nconst ctx = $('Extract Jira Fields').first().json;\nconst MARKER = 'AI-GOVERNOR-DOCREVIEW-V1';\nconst resp = $input.first().json || {};\nconst comments = resp.comments || (resp.body && resp.body.comments) || [];\n\nlet reviewBody = '';\nconst match = comments.find(c => (c.body || '').includes(MARKER));\nif (match) reviewBody = match.body || '';\n\nconst cleaned = reviewBody\n  .replace(/\\{anchor:[^}]+\\}/g, '')\n  .replace(/h[0-9]\\.\\s?/g, '')\n  .replace(/\\{panel[^}]*\\}/g, '')\n  .replace(/----/g, '\\u2014')\n  .trim();\n\nreturn [{ json: { ...ctx, reviewBody: cleaned || 'A document review was posted on the ticket.' } }];"
      },
      "id": "c244db55-ef66-487d-97d9-58ca049a521d",
      "name": "Extract Review Comment",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -720,
        144
      ]
    },
    {
      "parameters": {
        "jsCode": "// Build a SHORT Slack notification for the ticket reporter.\n// The full review stays on the Jira comment; we only link to the ticket here.\n// reviewBody is still carried through so the bot's chat history gets seeded.\nconst ctx = $input.first().json;            // carries reviewBody + ticket ctx\nconst api = $('Review Docs (Python API)').first().json;\nconst reviewed = api.reviewed || 0;\nconst reviewBody = ctx.reviewBody || '';\nconst jiraUrl = ctx.jiraUrl || `https://{{YOUR_JIRA_DOMAIN}}/browse/${ctx.issueKey}`;\n\nconst greeting = ctx.reporter ? `Hi ${ctx.reporter}, ` : '';\nconst summaryLine = ctx.summary ? `*${ctx.summary}*\\n` : '';\nconst slackText =\n  `📝 *Document Review — ${ctx.issueKey}*\\n` +\n  summaryLine +\n  `${greeting}AI Governor reviewed the PRD/Tech-Doc linked on your ticket ` +\n  `(${reviewed} document${reviewed === 1 ? '' : 's'} updated). The full review is posted as a comment on the ticket.\\n\\n` +\n  `🔗 ${jiraUrl}\\n\\n` +\n  `_Reply in this thread to ask the bot about the review or the documents._`;\n\nreturn [{ json: { ...ctx, reviewBody, slackText, jiraUrl } }];"
      },
      "id": "a2909a9e-c1f9-4eaa-a85a-684a2c9777ac",
      "name": "Prepare Reporter Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -528,
