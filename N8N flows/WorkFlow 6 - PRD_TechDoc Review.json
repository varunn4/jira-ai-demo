{
  "name": "WorkFlow 6 - PRD/TechDoc Review",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "jira-doc-review",
        "options": {}
      },
      "id": "26d7d20c-4dd3-487f-8b5d-b5e8c21904aa",
      "name": "Jira Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -2000,
        224
      ],
      "webhookId": "jira-doc-review"
    },
    {
      "parameters": {
        "jsCode": "// Pull issueKey, reporter, summary + raw description (string or ADF) from the Jira webhook.\nconst body = $input.first().json.body || $input.first().json;\nconst issue = body.issue || {};\nconst fields = issue.fields || {};\nconst description = fields.description ?? '';\n// Flatten ADF/string to a quick scan string just for the gate.\nconst scan = (typeof description === 'string') ? description : JSON.stringify(description);\n// Coarse pre-filter (Python API does authoritative extraction + dedup): pass for\n// a raw \"PRD: https://…\" link OR a labelled hyperlink (label + an href both\n// present, e.g. the word \"TechDoc\" linking to a URL via an ADF link mark).\nconst rawLink = /(PRD|Tech\\s*Doc|Technical\\s*Design|Design\\s*Doc)\\s*[:\\-]\\s*https?:\\/\\//i.test(scan);\nconst labelledHyperlink = /(PRD|Tech\\s*Doc|Technical\\s*Design|Design\\s*Doc)/i.test(scan) && /https?:\\/\\//.test(scan);\nconst hasDocLink = rawLink || labelledHyperlink;\nconst issueKey = issue.key || '';\nreturn [{ json: {\n  issueKey,\n  summary: fields.summary || '',\n  description,\n  hasDocLink,\n  reporter: (fields.reporter && fields.reporter.displayName) || '',\n  reporterEmail: (fields.reporter && fields.reporter.emailAddress) || '',\n  jiraUrl: issueKey ? `https://{{YOUR_JIRA_DOMAIN}}/browse/${issueKey}` : ''\n} }];"
      },
      "id": "02fc6d02-6f5b-48a1-9297-4a96757e7068",
      "name": "Extract Jira Fields",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -1776,
        224
      ]
    },
    {
