    {
      "parameters": {
        "url": "=https://{{YOUR_JIRA_DOMAIN}}/rest/api/2/issue/{{ $('Extract Jira Fields').item.json.issueKey }}/comment?maxResults=100",
        "authentication": "predefinedCredentialType",
