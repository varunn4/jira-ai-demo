        "operation": "executeQuery",
        "query": "INSERT INTO tickets (jira_ticket_id, slack_channel_id, slack_thread_ts, status)\nVALUES (\n  '{{ $('Extract Jira Fields').item.json.issueKey }}',\n  '{{ $json.channel || $json.message?.channel }}',\n  '{{ $json.message?.ts || $json.ts }}',\n  'open'\n)\nON CONFLICT (jira_ticket_id)\nDO UPDATE SET\n  slack_channel_id = EXCLUDED.slack_channel_id,\n  slack_thread_ts  = EXCLUDED.slack_thread_ts\nRETURNING id, jira_ticket_id, slack_channel_id, slack_thread_ts;",
