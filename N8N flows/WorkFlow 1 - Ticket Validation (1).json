    {
      "parameters": {
        "jsCode": "const issueKey = $('Extract Jira Fields').item.json.issueKey;\nconst priorityRaw = $('Extract API Response').item.json.priority;\nconst email = \"{{YOUR_JIRA_EMAIL}}\";\nconst apiToken = \"{{YOUR_JIRA_API_TOKEN}}\";\nconst credentials = Buffer.from(`${email}:${apiToken}`).toString('base64');\n\n// Exact Jira priority names\nconst priorityMap = {\n  'P0': 'P0 - Critical (System down / major revenue impact / Blocker)',\n  'P1': 'P1 - High (Major feature not works) and no workaround exists',\n  'P2': 'P2 - Medium (Exists for few users / workaround exists )',\n  'P3': 'P3 - Low (Minor / Exists for less than 10 customers)',\n  'P4': 'P4 - Trivial problem with little impact on progress.'\n};\n\nconst priority = priorityMap[priorityRaw] || priorityRaw;\n\nconst response = await this.helpers.request({\n  method: \"PUT\",\n  uri: `https://{{YOUR_JIRA_DOMAIN}}/rest/api/2/issue/${issueKey}`,\n  headers: {\n    \"Authorization\": `Basic ${credentials}`,\n    \"Content-Type\": \"application/json\",\n    \"Accept\": \"application/json\"\n  },\n  body: JSON.stringify({\n    fields: {\n      priority: {\n        name: priority\n      }\n    }\n  }),\n  resolveWithFullResponse: true\n});\n\nreturn [{ json: { statusCode: response.statusCode, issueKey, priority } }];"
      },
