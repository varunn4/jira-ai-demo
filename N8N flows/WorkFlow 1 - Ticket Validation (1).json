    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO sla_tracking (\n  ticket_id,\n  jira_ticket_id,\n  priority,\n  assignee_slack_id,\n  sla_start_time,\n  sla_deadline,\n  sla_window_hours\n)\nSELECT \n  id,\n  jira_ticket_id,\n  '{{ $('Extract API Response').item.json.priority }}',\n  assigned_user_id,\n  NOW(),\n  NOW() + (\n    CASE '{{ $('Extract API Response').item.json.priority }}'\n      WHEN 'P0' THEN INTERVAL '1 hour'\n      WHEN 'P1' THEN INTERVAL '4 hours'\n      WHEN 'P2' THEN INTERVAL '16 hours'\n      WHEN 'P3' THEN INTERVAL '24 hours'\n      WHEN 'P4' THEN INTERVAL '48 hours'\n      ELSE INTERVAL '24 hours'\n    END\n  ),\n  CASE '{{ $('Extract API Response').item.json.priority }}'\n    WHEN 'P0' THEN 1\n    WHEN 'P1' THEN 4\n    WHEN 'P2' THEN 16\n    WHEN 'P3' THEN 24\n    WHEN 'P4' THEN 48\n    ELSE 24\n  END\nFROM tickets\nWHERE jira_ticket_id = '{{ $('Extract Jira Fields').item.json.issueKey }}'\nON CONFLICT (jira_ticket_id)\nDO UPDATE SET\n  priority = EXCLUDED.priority,\n  assignee_slack_id = EXCLUDED.assignee_slack_id,\n  sla_start_time = NOW(),\n  sla_deadline = EXCLUDED.sla_deadline,\n  sla_window_hours = EXCLUDED.sla_window_hours,\n  alert_75_sent = FALSE,\n  alert_50_sent = FALSE,\n  alert_25_sent = FALSE,\n  alert_0_sent = FALSE,\n  is_resolved = FALSE;",
