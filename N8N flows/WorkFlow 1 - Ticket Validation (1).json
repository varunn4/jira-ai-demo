        "jsCode": "const changelog = $input.item.json.body.changelog?.items || [];\n\nconst ignoredFields = [\n  'status',\n  'resolution', \n  'statusCategory',\n  'statusId',\n  'Rank',              // ← ADD THIS\n  'rank',              // ← ADD THIS (lowercase too)\n  'assignee',          // ← when bot auto-assigns\n  'priority',          // ← when bot auto-sets priority\n  'customfield_10019', // ← Rank field ID\n];\n\nconst hasRealChange = changelog.some(\n  item => !ignoredFields.includes(item.field) && \n          !ignoredFields.includes(item.fieldId)\n);\n\nconst isNewTicket = $input.item.json.body.webhookEvent === 'jira:issue_created';\n\nreturn [{\n  json: {\n    ...$input.item.json,\n    shouldProcess: isNewTicket || hasRealChange\n  }\n}];"
