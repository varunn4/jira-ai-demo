      "position": [
        -976,
        448
      ]
    },
    {
      "parameters": {
        "jsCode": "const alerts = $input.item.json.alerts;\n\nif (!alerts || alerts.length === 0) {\n  return [];\n}\n\nreturn alerts.map(alert => ({\n  json: {\n    channel_id: alert.channel_id,\n    message: alert.message\n  }\n}));"
      },
      "id": "3e978013-6ee5-4dbb-82f3-1fe7942ca719",
      "name": "Split Alerts",
