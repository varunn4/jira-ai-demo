# ==============================================================================
# AI Governor (JIRA-AI) — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate the required values before deployment.
# Run `docker compose up -d` or start `uvicorn api:app --host 0.0.0.0 --port 8000`
# ==============================================================================

# ── Core Server & Repositories ───────────────────────────────────────────────
REPOSITORY_SEARCH_ROOT=/host-repos
REPOSITORY_HOST_ROOT=/host-repos
EXCLUDED_REPOSITORY_NAMES=JIRA-AI
HOST_REPO_DIR=.
HOST_SSH_DIR=~/.ssh

# ── PostgreSQL Database ──────────────────────────────────────────────────────
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/jira_ai
DOCKER_DATABASE_URL=postgresql://postgres:postgres@host.docker.internal:5432/jira_ai

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Options: anthropic | openai | groq | gemini | ollama
LLM_PROVIDER=anthropic
LLM_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ── Jira Cloud Integration ───────────────────────────────────────────────────
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_EMAIL=dev@yourcompany.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEYS=PROJ1,PROJ2
JIRA_EXCLUDED_PROJECT_KEYS=

# ── Slack Bot Integration ────────────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL_ID=C0123456789
GOVERNOR_NOTIFY_CHANNEL_ID=C0123456789

# ── Vector Search (Qdrant) & Embeddings (Ollama) ─────────────────────────────
QDRANT_URL=http://qdrant:6333
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_TIMEOUT_SECONDS=60
OLLAMA_EMBED_BATCH_SIZE=8
OLLAMA_NUM_PARALLEL=4

# ── Neo4j Code Graph ─────────────────────────────────────────────────────────
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ── n8n Orchestration Engine ─────────────────────────────────────────────────
N8N_BASE_URL=http://n8n:5678
N8N_API_KEY=
N8N_GRAPH_WEBHOOK_URL=

# ── GitHub & RepoTree Integration ────────────────────────────────────────────
GITHUB_TOKEN=
GITHUB_ORG=
REPO_TREE_SRC_PATH=/app
REPO_TREE_CONFIG_PATH=/app/repo_tree/config/repos.yaml
REPO_TREE_WORKSPACE_DIR=/app/repo_tree/workspace
REPO_TREE_TIMEOUT_SECONDS=300

# ── Authentication & Security ────────────────────────────────────────────────
# Set a strong secret key for JWT signing in production
JWT_SECRET=replace_with_a_secure_random_64_char_secret_for_production
ADMIN_EMAIL=admin@yourcompany.com
ADMIN_PASSWORD=adminpassword
